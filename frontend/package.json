    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.13",
    "mantine-datatable": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
