# Cloudflare's edge refuses request bodies over ~100 MB. The client blocks the
# upload before it starts rather than letting the user wait for a rejection that
# arrives as an HTML error page. Keep aligned with FILE_UPLOAD_MAX_MB in ../.env
VITE_MAX_UPLOAD_MB=95

# Vite dev-server proxy target. Production remains same-origin through Flask.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5112
